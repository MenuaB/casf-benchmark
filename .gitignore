__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/
outputs/
*.sqlite-journal

# Machine-specific, regenerated by scripts/build_generation_root_overrides.py
src/casf_benchmark/config/casf_generation_root_overrides.yaml

# Working directory of a single casf-extended-analysis invocation: memoization
# caches, plus CSV/SQLite mirrors of tables already published to
# data/results/extended_casf_analysis.sqlite. All regenerable; ~4.6G, 76k files.
data/results/extended_combined/*

# Precomputed dashboard artifacts, published as GitHub Release assets rather
# than committed: each is >100MB (GitHub's hard blob limit) and Git LFS is
# disabled for this repository. Regenerable via the rebuild/export CLIs.
data/results/casf_analysis_dashboard.sqlite
data/results/extended_casf_analysis.sqlite
data/results/casf_per_ligand_long.csv

# Partial downloads of the release assets above (see casf_benchmark/release_data.py).
data/results/*.sqlite.part

# Machine-specific log, not a result: one row per missing generation SDF, emitted
# when the extended k-efficiency pass runs against bundled run roots that ship
# analysis tables without the SDFs. ~10k rows of absolute Weka paths.
data/results/tables/extended_k_efficiency_failures.csv

# Reproducible common-protocol working data; published as release assets.
data/results/ref_protocol/
